{
  "name": "pok-ui",
  "version": "0.1.1",
  "private": true,
  "description": "POK desktop — chat and Path of Building workspace",
  "author": "POK",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/skerfolg/pok-ui.git" },
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm test",
    "start": "electron .",
    "runtime:stage": "node scripts/stage-runtime.mjs",
    "prepare:data-bundle": "node scripts/prepare-data-bundle.mjs",
    "bundle:prepare": "node scripts/prepare-bundle.mjs",
    "bundle:prepare-checkout": "node scripts/prepare-checkout-bundle.mjs",
    "build:local-exe": "npm run build && node scripts/build-local-exe.mjs",
    "verify:data-bundle": "node scripts/verify-data-bundle.mjs",
    "dist:win": "node scripts/verify-runtime.mjs win32 && node scripts/verify-tree-assets.mjs && npm run verify:data-bundle && npm run build && electron-builder --win portable --x64",
    "dist:mac": "node scripts/verify-runtime.mjs darwin && node scripts/verify-tree-assets.mjs && npm run verify:data-bundle && npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "playwright": "1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "dev.pok.desktop",
    "productName": "POK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/passive-tree", "to": "passive-tree", "filter": ["**/*"] },
      { "from": "resources/pob-catalog", "to": "pob-catalog", "filter": ["**/*"] },
      { "from": "resources/bundle-manifest.json", "to": "bundle-manifest.json" },
      {
        "from": "resources/pok-runtime",
        "to": "pok-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "artifactName": "POK-${version}-${os}-${arch}.${ext}"
  }
}
